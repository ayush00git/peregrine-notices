{
  "name": "peregrine-notices",
  "version": "1.0.0",
  "private": true,
  "description": "Service-change notices built on Hyper Elements template(): a rider email, a poster for every affected stop and a social card, with guardrails that refuse unsafe notices.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "hyper-elements check templates/ --max-warnings 0 && hyper-elements check designs/ --require-template --max-warnings 0",
    "render": "hyper-elements render designs/",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "gallery": "tsx scripts/gallery.ts && tsx scripts/gallery-check.tsx",
    "hero": "tsx scripts/hero.tsx",
    "gif": "tsx scripts/gif.tsx",
    "previews": "tsx scripts/previews.tsx",
    "rerecord": "tsx scripts/rerecord.ts"
  },
  "hyperElements": {
    "templates": [
      "templates/**"
    ]
  },
  "dependencies": {
    "@hyper-elements/lint": "0.1.8",
    "@hyper-elements/react": "0.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@resvg/resvg-js": "2.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "0.33.5"
  },
  "devDependencies": {
    "@hyper-elements/cli": "0.3.0",
    "@hyper-elements/email-clients": "0.5.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
